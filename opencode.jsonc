{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 3,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["bash", "/home/ubuntu/.config/opencode/playwright-win-chrome.sh"],
      "enabled": true
    }
  },
  "instructions": [
    "/home/ubuntu/.config/opencode/HARNESS-CONTRACT.md"
  ],
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    },
    "agentrouter": {
      "npm": "@ai-sdk/anthropic",
      "name": "AgentRouter (Anthropic)",
      "options": {
        "baseURL": "https://agentrouter-proxy.dickelijah4.workers.dev",
        "apiKey": "{env:AGENTROUTER_API_KEY}"
      },
      "models": {
        "claude-opus-4-8": {
          "name": "claude-opus-4-8"
        },
        "claude-opus-5": {
          "name": "claude-opus-5"
        }
      }
    },
    "agentrouter-openai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AgentRouter (OpenAI Compatible)",
      "options": {
        "baseURL": "https://agentrouter-proxy.dickelijah4.workers.dev/v1",
        "apiKey": "{env:AGENTROUTER_API_KEY}"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol"
        },
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash"
        },
        "glm-5.3": {
          "name": "glm-5.3"
        },
        "gpt-6-astra": {
          "name": "gpt-6-astra"
        }
      }
    },
    "google": {
      "npm": "@ai-sdk/google",
      "name": "Google Gemini",
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      },
      "models": {
        "gemini-3.6-flash": {
          "name": "gemini-3.6-flash"
        },
        "gemini-3.6-flash-lite": {
          "name": "gemini-3.6-flash-lite"
        }
      }
    },
    "bluesminds": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "BluesMinds",
      "options": {
        "baseURL": "https://api.bluesminds.com/v1",
        "apiKey": "{env:BLUESMINDS_API_KEY}"
      },
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna"
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra"
        },
        "gpt-5.2-chat": {
          "name": "GPT-5.2 Chat"
        },
        "gpt-5-mini": {
          "name": "GPT-5 Mini"
        },
        "gpt-4o": {
          "name": "GPT-4o"
        },
        "meta/llama-3.2-11b-vision-instruct": {
          "name": "meta/llama-3.2-11b-vision-instruct"
        },
        "nvidia/llama-3.1-nemoguard-8b-topic-control": {
          "name": "nvidia/llama-3.1-nemoguard-8b-topic-control"
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro"
        },
        "openai/gpt-oss-20b": {
          "name": "openai/gpt-oss-20b"
        },
        "google/diffusiongemma-26b-a4b-it": {
          "name": "google/diffusiongemma-26b-a4b-it"
        }
      }
    }
  }
}
